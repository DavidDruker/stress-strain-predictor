.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# Data: raw and processed are reproducible from the documented DOIs, never committed.
data/raw/
data/processed/
# data/external/ IS committed (small, vendored with provenance) - see data/README.md

# The fitted model is reproducible from the committed code, the pinned
# requirements, the seed and the dataset checksum, so the .joblib stays out.
# Its sidecar IS committed: it documents what actually shipped -- the selected
# hyper-parameters, training row/grade counts, library versions and the SHA-256
# of the exact CSV the model descended from. That record is not regenerable
# after the fact, and a model whose provenance lives only on one laptop is not
# reproducible in any useful sense.
artifacts/*
!artifacts/*.json

# Per-run console logs from parallel evaluation invocations.
reports/.log_*
reports/.done_*
reports/.err_*

# Per-row out-of-fold predictions (~7 MB) and the per-protocol bundles that the
# merged report is built from. All regenerable with `evaluate` + `report`; only
# the merged bundle and the rendered results.md are committed.
reports/oof_*.csv
reports/eval_*_random_kfold.json
reports/eval_*_gkf_grade.json
reports/eval_*_lofo_family.json
reports/eval_*_loso_source.json
