.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# Data: raw and processed are reproducible from the documented DOIs, never committed.
data/raw/
data/processed/
# data/external/ IS committed (small, vendored with provenance) - see data/README.md

# Model artifacts are reproducible from a seed; only reports/ is committed.
artifacts/

# Per-run console logs from parallel evaluation invocations.
reports/.log_*
reports/.done_*
reports/.err_*

# Per-row out-of-fold predictions (~7 MB) and the per-protocol bundles that the
# merged report is built from. All regenerable with `evaluate` + `report`; only
# the merged bundle and the rendered results.md are committed.
reports/oof_*.csv
reports/eval_*_random_kfold.json
reports/eval_*_gkf_grade.json
reports/eval_*_lofo_family.json
reports/eval_*_loso_source.json
